# units verifier kit: the one config file. Read by ./units-verifier and by compose.yaml.
# A variable already set in your shell wins over the value here.

# The network to work on: mainnet (default) or devnet. `./units-verifier --network devnet <command>`
# switches for one command.
UNITS_NETWORK=mainnet

# The public site of each network. Reads (verify, verify-generation, params, latest) go here.
UNITS_SITE_MAINNET=https://main-157-245-71-188.sslip.io
UNITS_SITE_DEVNET=https://157-245-71-188.sslip.io

# Set this to send every command to one Core address, whatever the network (for example a Core you
# run yourself, or a worker address the network operator gave you). Empty: the site above.
UNITS_CORE=

# Where the worker keeps its state: repository mirrors, dependency layers, work directories and the
# reveals it still owes. It must be the SAME absolute path on the host and in the container, because
# the host's Docker daemon resolves the sandbox mounts. On Docker Desktop (macOS) use a directory
# under a shared path, for example /private/tmp/units.
UNITS_HOME=/var/lib/units

# The worker key (a Solana keypair file). Made by `./units-verifier keygen`. Mounted read only.
UNITS_KEY=./keys/agent.json

# The image this kit builds, and the name of the long-running worker container.
UNITS_IMAGE=units/verifier:local
UNITS_CONTAINER=units-verifier

# The host's Docker socket. Rootless Docker: $XDG_RUNTIME_DIR/docker.sock.
UNITS_DOCKER_SOCK=/var/run/docker.sock

# Seconds a stopping worker gets to finish and reveal what it committed (see README, "Stop it slowly").
UNITS_STOP_TIMEOUT=900

# A mainnet RPC address, only for `verify --chain` on mainnet (it reads slots from the cluster).
# Never commit a keyed address: put it in your shell instead.
UNITS_MAINNET_RPC=
